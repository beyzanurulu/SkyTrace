# All-in-one offline image: Ollama with qwen2.5:7b + bge-m3 already pulled,
# SkyTrace, and the documentation index. Runs with no network at all:
#
#   skytrace docs build                     # once, on the host (needs internet)
#   docker build -f docker/Dockerfile.bundle -t skytrace:bundle .
#   docker run --rm --network none skytrace:bundle python eval/offline_e2e.py
#   docker run --rm -p 127.0.0.1:8000:8000 skytrace:bundle   # web UI
#
# About 7 GB (the models are 5.5 GB). Add --gpus all for an NVIDIA GPU.
FROM ollama/ollama:0.40.7

RUN ollama serve >/tmp/ollama.log 2>&1 & \
    until ollama list >/dev/null 2>&1; do sleep 1; done && \
    ollama pull qwen2.5:7b && ollama pull bge-m3

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/opt/python
RUN uv python install 3.11
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --python 3.11 --no-default-groups --extra web --no-install-project
COPY src ./src
RUN uv sync --frozen --python 3.11 --no-default-groups --extra web

COPY docker/bundle-entrypoint.sh /usr/local/bin/bundle-entrypoint.sh
COPY eval/offline_e2e.py ./eval/offline_e2e.py
COPY tests/fixtures/sample_log_small.ulg ./tests/fixtures/sample_log_small.ulg
COPY data/rag ./data/rag

ENV PATH="/app/.venv/bin:$PATH" SKYTRACE_MODE=offline OLLAMA_HOST=127.0.0.1:11434
EXPOSE 8000
ENTRYPOINT ["/bin/sh", "/usr/local/bin/bundle-entrypoint.sh"]
CMD ["skytrace", "serve", "--host", "0.0.0.0"]
